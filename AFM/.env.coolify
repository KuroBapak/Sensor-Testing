# Environment for Coolify -> your app -> Environment Variables (Developer view: paste all).
# Generated by init.php from .env.example for THIS app. Fill every CHANGE_ME / empty secret.
# Generate APP_KEY with:  php artisan key:generate --show
# Never commit real secrets. VITE_* values are not here: they live in .env.build.
# Values are written without quotes on purpose: they reach the container exactly as typed.

APP_NAME=Automatic Fuel Management
APP_ENV=production
# required: php artisan key:generate --show   (keep it forever once in use)
APP_KEY=
APP_DEBUG=false
APP_URL=https://CHANGE_ME

APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=mysql

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# no queued jobs detected: "database" would need a worker service, so run jobs inline
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME=Monitoring BBM

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Database: use the hostname Coolify shows for your database resource
DB_HOST=CHANGE_ME
DB_PORT=3306
DB_USERNAME=CHANGE_ME
DB_PASSWORD=CHANGE_ME
DB_DATABASE=CHANGE_ME

# ---- Added by the deploy pack ----
# true = run "php artisan migrate --force" on every start (a failed migration stops the container)
AUTO_MIGRATE=true
# Pin / roll back to a build: APP_IMAGE_TAG=sha-<commit> (remove to follow :latest)
# APP_IMAGE_TAG=latest
