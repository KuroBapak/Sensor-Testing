# Environment variables to enter in Coolify -> your app -> Environment Variables.
# They reach the containers through `env_file: .env` in docker-compose.yaml.
# This file is a checklist - do NOT put real secrets in it or commit them.
# Compare with the app's own .env.example and add anything it lists.

# ---- Required --------------------------------------------------
APP_NAME="My App"
APP_ENV=production
APP_DEBUG=false
# Generate locally:  php artisan key:generate --show
APP_KEY=base64:CHANGE_ME
APP_URL=https://app.example.com

# Optional app settings (only if the app uses them)
# APP_TIMEZONE=Asia/Jakarta
# APP_LOCALE=en
# APP_FALLBACK_LOCALE=en

# ---- Database --------------------------------------------------
# External database (Coolify-managed MySQL / PostgreSQL):
DB_CONNECTION=mysql
DB_HOST=CHANGE_ME
DB_PORT=3306
DB_DATABASE=CHANGE_ME
DB_USERNAME=CHANGE_ME
DB_PASSWORD=CHANGE_ME

# SQLite instead (keep it inside the storage volume, never /app/database):
# DB_CONNECTION=sqlite
# DB_DATABASE=/app/storage/database/database.sqlite

# ---- Drivers ---------------------------------------------------
SESSION_DRIVER=database
CACHE_STORE=database
# "database" needs a queue worker (uncomment `queue` in the compose file).
# Use "sync" if the app has no queued jobs.
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

# ---- Deploy behaviour -------------------------------------------
# Run `php artisan migrate --force` on every container start.
# Leave false and migrate manually if you prefer to control it.
AUTO_MIGRATE=false
# Pin / roll back: sha-<short-commit>. Remove to follow :latest.
# APP_IMAGE_TAG=latest

# ---- Mail / S3 / Reverb (only if used) ---------------------------
# MAIL_MAILER=smtp
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=
# AWS_BUCKET=
# BROADCAST_CONNECTION=reverb
# REVERB_APP_ID=
# REVERB_APP_KEY=
# REVERB_APP_SECRET=

# NOTE: VITE_* variables do NOT belong here. They are compiled into the
# JavaScript at build time: put them in .env.build and rebuild the image.
