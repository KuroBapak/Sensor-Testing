# Copy to .env.build next to the Dockerfile (the build scripts read it).
#
# Build-time values for the frontend. Vite compiles VITE_* variables into the
# JavaScript, so they must exist when the image is BUILT - setting them in
# Coolify later does nothing. Only VITE_* lines are used.
#
# These end up in the public JS bundle: never put secrets here.
# Every variable needs a matching ARG line in the Dockerfile.
# .dockerignore excludes .env.* so this file never enters the image.

VITE_APP_NAME="My App"

# Reverb / Echo (also uncomment the ARGs in the Dockerfile):
# VITE_BROADCAST_CONNECTION=reverb
# VITE_REVERB_APP_KEY=
# VITE_REVERB_HOST=ws.example.com
# VITE_REVERB_PORT=443
# VITE_REVERB_SCHEME=https
