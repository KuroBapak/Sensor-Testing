# Graphify generated machine/visualization data; keep GRAPH_REPORT.md readable
graphify-out/graph.json
graphify-out/graph.html
graphify-out/.graphify_analysis.json
graphify-out/.graphify_labels.json

# Secrets, credentials, dumps, keys, and noisy local artifacts
.env
.env.*
!.env.example
.npmrc
*.log
*.pem
*.key
*.p12
*.pfx
*.sql
*.sql.gz
*.dump
*.bak
*.tmp
